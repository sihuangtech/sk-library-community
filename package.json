{
  "name": "sk-library-community",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build && node scripts/copy-config.js",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "cross-env PORT=3008 HOST=127.0.0.1 node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "config:update": "node scripts/update-prisma-config.mjs",
    "config:validate": "node -e \"console.log('配置验证:', JSON.stringify(require('./utils/config.ts').loadConfig(), null, 2))\"",
    "db:init": "node scripts/init-database.mjs",
    "db:reset": "npx prisma migrate reset --force",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.9",
    "@nuxt/test-utils": "^4.3.2",
    "@prisma/client": "^7.10.0",
    "@types/js-yaml": "^4.0.9",
    "@types/sortablejs": "^1.15.9",
    "@unhead/vue": "^3.4.1",
    "@vue/compiler-sfc": "^3.5.43",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "js-yaml": "^5.4.2",
    "nuxt": "^4.5.2",
    "prisma": "^7.10.0",
    "sortablejs": "^1.15.7",
    "typescript": "^7.0.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
